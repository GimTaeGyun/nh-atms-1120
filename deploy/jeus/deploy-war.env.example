# =====================================================================
# ~/deploy/deploy-war.env (600) — deploy/jeus/deploy-war.sh 가 읽는 서버 설정
#   install-deploy-war.sh 가 없을 때만 이 파일을 복사해 만든다 (이미 있으면 건드리지 않음)
#   bash 로 읽으므로 "이름=값" 형식, = 앞뒤 공백 없이
#
# 구성 (2026-10-26): JEUS 도메인 1개 + 매니지드 서버 6개, 컨텍스트 '/'
#   키      모듈              서버
#   web     atms-web          atms01
#   journal atms-journal      ajou01
#   batch   atms-batch        abat01
#   file    atms-file         file01
#   ifin    atms-if-internal  ifin01
#   ifex    atms-if-external  ifex01
#
# 2026-11-09: 인프라가 포트를 알려 주지 않는다 → 포트 없이 재기동 메뉴만으로 운영한다.
#   재기동 확인 = 프로세스 + 앱 로그 (PORT_<키> 가 비어 있을 때, 기본)
#     정지: JEUS_USER(jeusatms) 의 java 중 -Dobj_name=<SERVER_키> 가 사라짐
#     기동: JEUS_LOG_DIR/<모듈>.log 에 새로 'Started Atms…Application' (APPLICATION FAILED 면 실패)
#   → SERVER_<키> 가 실제 서버 이름(obj_name)과 같아야 한다. 확인: ps -u jeusatms -o args= | grep -o 'obj_name=[^ ]*' | sort
#   → 앱 로그를 atmswas 가 읽을 수 있어야 한다. 확인: ls -l /WASlogs/jeusATMSlogs/nbatmsltws01/app
#   아래 주석(#) 줄은 스크립트 기본값 — WAS 담당 회신이 다르면 주석을 풀고 바꾼다
# =====================================================================

# 서버 주소 (리스너가 LISTEN 하는 IP — 127.0.0.1 은 안 됨, 2026-10-23)
#JEUS_HOST=16.88.122.113

# 포트 — 모르면 비워 둔다(기본). 알게 되면 넣는다: 그 모듈은 포트로 확인(/v3/api-docs 200)
#PORT_web=8080
#PORT_journal=8081
#PORT_batch=8082
#PORT_file=8083
#PORT_ifin=8084
#PORT_ifex=8085

# 서버 이름 — 포트가 없으면 정지 확인에 쓴다(obj_name). 위 ps 결과와 글자까지 같게 (예: nbatmsltws01_atms01 이면 그대로)
SERVER_web=nbatmsltws01_atms01
SERVER_journal=nbatmsltws01_ajou01
SERVER_batch=nbatmsltws01_abat01
SERVER_file=nbatmsltws01_file01
SERVER_ifin=nbatmsltws01_ifin01
SERVER_ifex=nbatmsltws01_ifex01

# 재기동 메뉴 번호 (/JEUS/jeusATMS/jeusMENU/jeusRstart, jeusmenu.c 로 확인)
#   jeusmenu.c(2026-11-09 13:52): 5/6 atms01, 7/8 ajou01, 9/10 abat01, 11/12 file01, 13/14 ifin01, 15/16 ifex01 (기동/정지),
#   17/18 webatms(WebtoB) — 아래 번호는 그 소스 기준. 실행 파일 jeusRstart 가 다시 컴파일돼야 맞다
#   (2026-11-09 관찰: 실행 파일은 10-22 판, atms01 만 들어 있음 → 스크립트가 안전장치로 메뉴를 넣지 않음, 재컴파일 뒤 자동으로 풀림)
#   비어 있으면 그 모듈은 재기동하지 않음 → "WAS 담당 재기동 필요" (Jenkins UNSTABLE)
#   3·17·18 은 스크립트가 거부 (3 = jeusatms java 전부 kill, 17·18 = WebtoB)
STOP_MENU_web=6
BOOT_MENU_web=5
STOP_MENU_journal=8
BOOT_MENU_journal=7
STOP_MENU_batch=10
BOOT_MENU_batch=9
STOP_MENU_file=12
BOOT_MENU_file=11
STOP_MENU_ifin=14
BOOT_MENU_ifin=13
STOP_MENU_ifex=16
BOOT_MENU_ifex=15

# 프로세스·로그 확인용 (기본값)
#JEUS_USER=jeusatms
#JEUS_LOG_DIR=/WASlogs/jeusATMSlogs/nbatmsltws01/app

# 대기 시간(초)
#STOP_WAIT=180
#BOOT_WAIT=600

# 기동 확인에서 뺄 모듈 (예: DB 준비 전 atms-batch). 여러 개는 공백으로: "atms-batch atms-file"
HEALTH_SKIP=""
